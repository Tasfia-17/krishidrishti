# KrishiDrishti — Environment Configuration
# Copy this file to .env and fill in your values

# ── llama-server connection ───────────────────────────────────────────────────
# URL where llama-server is running with your Gemma 4 model loaded
LLAMA_SERVER_HOST=http://localhost:8080

# ── Server settings ───────────────────────────────────────────────────────────
# Host and port for the KrishiDrishti API server
KRISHIDRISHTI_HOST=0.0.0.0
KRISHIDRISHTI_PORT=7878

# ── Database ──────────────────────────────────────────────────────────────────
# Path to SQLite database for diagnosis history
DB_PATH=~/.krishidrishti/diagnoses.db

# ── Upload settings ───────────────────────────────────────────────────────────
# Max image upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# ── Analysis settings ─────────────────────────────────────────────────────────
# Analysis mode: fast (~12s), balanced (~30s), accurate (~60s)
ANALYSIS_MODE=balanced

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
